{{!
    @template mod_vocabmastery/trainer_summary

    End-of-session summary.

    Example context (json):
    {
        "icon": {"ic_award": true}, "iconclass": "vm-summary-icon-award", "title": "Passed!", "big": "94%",
        "bigclass": "vm-good", "lines": [{"text": "17 / 18 correct"}], "showmastery": true, "masterylabel": "Topic mastery now:",
        "mastery": 94, "newlypassed": "Topic mastered - 94%", "wherenextlabel": "Where next?",
        "routes": [{"url": "#", "type": "horizontal", "icon": {"ic_right": true}, "label": "Continue in this level",
            "name": "A1 · Lektion 2"}],
        "mistakeslabel": "Words to review", "mistakes": [{"full": "die Frau", "translation": "woman"}],
        "actions": [{"action": "back", "label": "Back to topic", "cls": "vm-btn-ghost"}],
        "icons": {"trophy": {"ic_trophy": true}, "award": {"ic_award": true} }
    }
}}
<div class="vm-summary-icon {{iconclass}}">{{#icon}}{{> mod_vocabmastery/icon}}{{/icon}}</div>
<div class="vm-summary-title">{{title}}</div>
{{#best}}<div class="vm-pb">{{#icons.trophy}}{{> mod_vocabmastery/icon}}{{/icons.trophy}}<span>{{bestlabel}}</span></div>{{/best}}
<div class="vm-summary-big {{bigclass}}">{{big}}</div>
{{#lines}}<div class="vm-muted">{{text}}</div>{{/lines}}
{{#showmastery}}<div class="vm-summary-mastery"><span>{{masterylabel}}</span> <b>{{mastery}}%</b></div>{{/showmastery}}
{{#newlypassed}}<div class="vm-passed-badge vm-pop">{{#icons.award}}{{> mod_vocabmastery/icon}}{{/icons.award}}<span>{{newlypassed}}</span></div>{{/newlypassed}}
{{#hasroutes}}
<div class="vm-routes vm-route-list">
    <div class="vm-section-label">{{wherenextlabel}}</div>
    {{#routes}}
    <a class="vm-route vm-route-{{type}}" href="{{url}}">
        <span class="vm-route-icon">{{#icon}}{{> mod_vocabmastery/icon}}{{/icon}}</span>
        <span class="vm-route-body"><span class="vm-route-lbl">{{label}}</span><span class="vm-route-name">{{name}}</span></span>
    </a>
    {{/routes}}
</div>
{{/hasroutes}}
{{#hasmistakes}}
<div class="vm-section-label">{{mistakeslabel}}</div>
<ul class="vm-wordlist vm-wordlist-compact">
    {{#mistakes}}<li><span class="vm-word">{{full}}</span>{{#translation}}<span class="vm-muted">{{translation}}</span>{{/translation}}</li>{{/mistakes}}
</ul>
{{/hasmistakes}}
<div class="vm-tr-actions vm-summary-actions">
    {{#actions}}<button type="button" class="vm-btn {{cls}}" data-action="{{action}}">{{label}}</button>{{/actions}}
</div>
{{#failedsave}}<div class="vm-note">{{failedsave}}</div>{{/failedsave}}
