{{!
    @template mod_vocabmastery/report_heatmap

    Students × topics status grid.

    Example context (json):
    {
        "topics": [{"label": "A1 · Lektion 1"}],
        "rows": [{"url": "#", "name": "Anna", "cells": [{"cls": "passed", "label": "✓", "title": "Lektion 1: Mastered"}]}]
    }
}}
<div class="vm-legend mb-2">
    <span class="vm-hm-passed">{{#str}}heat_passed, mod_vocabmastery{{/str}}</span>
    <span class="vm-hm-active">{{#str}}heat_active, mod_vocabmastery{{/str}}</span>
    <span class="vm-hm-struggling">{{#str}}heat_struggling, mod_vocabmastery{{/str}}</span>
    <span class="vm-hm-none">{{#str}}heat_none, mod_vocabmastery{{/str}}</span>
</div>
<div class="table-responsive">
<table class="table table-sm table-bordered vm-heatmap">
    <thead><tr>
        <th scope="col">{{#str}}student, mod_vocabmastery{{/str}}</th>
        {{#topics}}<th scope="col" class="vm-hm-head" title="{{label}}">{{label}}</th>{{/topics}}
    </tr></thead>
    <tbody>
        {{#rows}}
        <tr>
            <th scope="row"><a href="{{url}}">{{name}}</a></th>
            {{#cells}}<td class="vm-hm vm-hm-{{cls}}" title="{{title}}">{{label}}</td>{{/cells}}
        </tr>
        {{/rows}}
    </tbody>
</table>
</div>
