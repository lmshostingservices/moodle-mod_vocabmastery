{{!
    @template mod_vocabmastery/import_docx_preview

    Preview of parsed Word documents with a tick box per detected section.

    Example context (json):
    {
        "actionurl": "#", "sesskey": "abc", "token": "t1", "summary": "4 files · 13 sets",
        "duplicates": [{"value": "skip", "label": "Skip", "selected": true}], "cancelurl": "#",
        "levels": [{"name": "A1", "docs": [{"key": "f0", "topic": "Lektion 1 – Hallo Welt!", "filename": "L1.docx",
            "level": "A1", "sections": [{"inputid": "sec_f0_s0", "label": "Nomen + Artikel", "count": "18 core",
            "checked": true, "answers": "der / die / das", "gated": true, "skippedcount": "", "skippedlist": ""}],
            "warnings": [], "notes": ""}]}]
    }
}}
<p class="text-muted">{{#str}}importpreview_help, mod_vocabmastery{{/str}}</p>
<div class="alert alert-info">{{summary}}</div>
<form method="post" action="{{actionurl}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="step" value="importdocx">
    <input type="hidden" name="token" value="{{token}}">
    <input type="hidden" name="source" value="word">
    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap gap-4 align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="importnotes" value="1" id="vm-importnotes" checked>
                <label class="form-check-label" for="vm-importnotes">{{#str}}importnotes, mod_vocabmastery{{/str}}</label>
            </div>
            <div>
                <label for="vm-dups" class="me-2">{{#str}}duplicates, mod_vocabmastery{{/str}}</label>
                <select name="duplicates" id="vm-dups" class="form-select d-inline w-auto">
                    {{#duplicates}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/duplicates}}
                </select>
            </div>
        </div>
    </div>
    {{#levels}}
    <h3 class="mt-4">{{name}}</h3>
    {{#docs}}
    <div class="card mb-2">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <strong>{{topic}}</strong>
                <span class="text-muted small">{{filename}}</span>
                <span class="ms-auto small">
                    <label for="vm-level-{{key}}" class="me-1">{{#str}}level, mod_vocabmastery{{/str}}</label>
                    <input type="text" name="level_{{key}}" id="vm-level-{{key}}" value="{{level}}" size="6"
                           class="form-control form-control-sm d-inline w-auto">
                </span>
            </div>
            <ul class="list-unstyled mb-0 mt-2">
                {{#sections}}
                <li class="py-1">
                    <input type="checkbox" class="form-check-input" name="{{inputid}}" id="{{inputid}}" value="1" {{#checked}}checked{{/checked}}>
                    <label for="{{inputid}}" class="mb-0">
                        {{label}} — {{count}}
                        {{#skippedcount}}<span class="badge bg-warning text-dark" title="{{skippedlist}}">{{skippedcount}}</span>{{/skippedcount}}
                        <span class="badge bg-light text-dark">{{answers}}</span>
                        {{#gated}}<span class="badge bg-success">{{#str}}gatedshort, mod_vocabmastery{{/str}}</span>{{/gated}}
                    </label>
                </li>
                {{/sections}}
            </ul>
            {{#warnings}}<div class="small text-warning">{{text}}</div>{{/warnings}}
            {{#notes}}
            <details><summary class="small text-muted">{{#str}}teachernotes, mod_vocabmastery{{/str}}</summary>
                <div class="small text-muted vm-prewrap">{{notes}}</div></details>
            {{/notes}}
        </div>
    </div>
    {{/docs}}
    {{/levels}}
    <div class="vm-stickybar">
        <button type="submit" class="btn btn-primary">{{#str}}importnow, mod_vocabmastery{{/str}}</button>
        <a class="btn btn-secondary" href="{{cancelurl}}">{{#str}}cancel{{/str}}</a>
    </div>
</form>
