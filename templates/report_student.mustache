{{!
    @template mod_vocabmastery/report_student

    One student's detail report.

    Example context (json):
    {
        "picture": "", "name": "Anna", "overall": 42, "passedsummary": "3 of 34 topics mastered",
        "levels": [{"name": "A1", "status": "84%", "passed": "10 / 12"}],
        "topics": [{"level": "A1", "name": "Lektion 1", "mastery": "100% (18/18)", "besttest": "100%", "accuracy": "91%", "status": "Mastered"}],
        "hasdifficult": false, "difficult": [], "hassessions": false, "sessions": [], "reseturl": "#"
    }
}}
<h3>{{{picture}}} {{name}}</h3>
<p>{{#str}}overallprogress, mod_vocabmastery{{/str}}: <b>{{overall}}%</b> · {{passedsummary}}</p>
<table class="table table-sm w-auto">
    <thead><tr><th scope="col">{{#str}}level, mod_vocabmastery{{/str}}</th><th scope="col">{{#str}}status{{/str}}</th><th scope="col">{{#str}}topicspassed, mod_vocabmastery{{/str}}</th></tr></thead>
    <tbody>{{#levels}}<tr><td>{{name}}</td><td>{{status}}</td><td>{{passed}}</td></tr>{{/levels}}</tbody>
</table>
<h4>{{#str}}topics, mod_vocabmastery{{/str}}</h4>
<div class="table-responsive">
<table class="table table-sm table-striped">
    <thead><tr>
        <th scope="col">{{#str}}level, mod_vocabmastery{{/str}}</th><th scope="col">{{#str}}topic, mod_vocabmastery{{/str}}</th>
        <th scope="col">{{#str}}mastery, mod_vocabmastery{{/str}}</th><th scope="col">{{#str}}besttestshort, mod_vocabmastery{{/str}}</th>
        <th scope="col">{{#str}}accuracy, mod_vocabmastery{{/str}}</th><th scope="col">{{#str}}status{{/str}}</th>
    </tr></thead>
    <tbody>{{#topics}}<tr><td>{{level}}</td><td>{{name}}</td><td>{{mastery}}</td><td>{{besttest}}</td><td>{{accuracy}}</td><td>{{status}}</td></tr>{{/topics}}</tbody>
</table>
</div>
<h4>{{#str}}difficultitems, mod_vocabmastery{{/str}}</h4>
{{^hasdifficult}}<p class="text-muted">{{#str}}nodifficultitems, mod_vocabmastery{{/str}}</p>{{/hasdifficult}}
{{#hasdifficult}}
<table class="table table-sm">
    <thead><tr><th scope="col">{{#str}}field_prompt, mod_vocabmastery{{/str}}</th><th scope="col">{{#str}}field_correctvalue, mod_vocabmastery{{/str}}</th><th scope="col">{{#str}}wrongofattempts, mod_vocabmastery{{/str}}</th></tr></thead>
    <tbody>{{#difficult}}<tr><td>{{prompt}}</td><td>{{correct}}</td><td>{{ratio}}</td></tr>{{/difficult}}</tbody>
</table>
{{/hasdifficult}}
<h4>{{#str}}recentsessions, mod_vocabmastery{{/str}}</h4>
{{^hassessions}}<p class="text-muted">{{#str}}nosessions, mod_vocabmastery{{/str}}</p>{{/hassessions}}
{{#hassessions}}
<table class="table table-sm">
    <thead><tr><th scope="col">{{#str}}date{{/str}}</th><th scope="col">{{#str}}mode, mod_vocabmastery{{/str}}</th><th scope="col">{{#str}}topic, mod_vocabmastery{{/str}}</th><th scope="col">{{#str}}answers, mod_vocabmastery{{/str}}</th><th scope="col">{{#str}}score, mod_vocabmastery{{/str}}</th></tr></thead>
    <tbody>{{#sessions}}<tr><td>{{date}}</td><td>{{mode}}</td><td>{{topic}}</td><td>{{answers}}</td><td>{{score}}</td></tr>{{/sessions}}</tbody>
</table>
{{/hassessions}}
{{#reseturl}}<a class="btn btn-outline-danger mt-3" href="{{reseturl}}">{{#str}}resetprogress, mod_vocabmastery{{/str}}</a>{{/reseturl}}
