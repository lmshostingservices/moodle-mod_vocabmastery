{{!
    @template mod_vocabmastery/credentials_status

    Admin settings: which LMS Labs credentials this plugin will use. Never shows the API key.

    Example context (json):
    {
        "central": true, "local": false, "none": false, "siteid": "LMS-1234", "centralinstalled": true,
        "centralurl": "https://example.com/admin/settings.php?section=local_aiconfig",
        "activationurl": "https://example.com/mod/vocabmastery/activation.php"
    }
}}
<p>{{#str}}lmslabs_heading_desc, mod_vocabmastery{{/str}}</p>
{{#central}}<div class="alert alert-success">{{#str}}lmslabs_using_central, mod_vocabmastery, {{siteid}}{{/str}}</div>{{/central}}
{{#local}}<div class="alert alert-info">{{#str}}lmslabs_using_local, mod_vocabmastery, {{siteid}}{{/str}}</div>{{/local}}
{{#none}}<div class="alert alert-warning">{{#str}}lmslabscredentialsmissing, mod_vocabmastery{{/str}}</div>{{/none}}
{{^centralinstalled}}<p class="text-muted">{{#str}}lmslabs_central_missing, mod_vocabmastery{{/str}}</p>{{/centralinstalled}}
{{#centralurl}}<p><a href="{{centralurl}}">{{#str}}lmslabs_open_central, mod_vocabmastery{{/str}}</a></p>{{/centralurl}}
<p><a href="{{activationurl}}">{{#str}}act_title, mod_vocabmastery{{/str}}</a></p>
