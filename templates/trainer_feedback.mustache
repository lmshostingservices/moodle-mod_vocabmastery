{{!
    @template mod_vocabmastery/trainer_feedback

    Feedback after a practice answer.

    Example context (json):
    {
        "correct": false, "chosenmsg": "You chose \"die\"", "correctlabel": "Correct:", "full": "der Vater",
        "sub": "father (Väter)", "extra": "This word will appear again shortly.",
        "icons": {"check": {"ic_check": true}, "close": {"ic_close": true} }
    }
}}
{{#correct}}
<div class="vm-fb-good"><span class="vm-fb-icon">{{#icons.check}}{{> mod_vocabmastery/icon}}{{/icons.check}}</span><b>{{full}}</b></div>
{{#sub}}<div class="vm-muted">{{sub}}</div>{{/sub}}
{{/correct}}
{{^correct}}
<div class="vm-fb-bad"><span class="vm-fb-icon">{{#icons.close}}{{> mod_vocabmastery/icon}}{{/icons.close}}</span><span>{{chosenmsg}}</span></div>
<div class="vm-fb-correct"><span class="vm-muted">{{correctlabel}}</span> <b>{{full}}</b></div>
{{#sub}}<div class="vm-muted">{{sub}}</div>{{/sub}}
{{#explanation}}<div class="vm-tr-hint">{{explanation}}</div>{{/explanation}}
{{/correct}}
{{#extra}}<div class="vm-fb-extra">{{extra}}</div>{{/extra}}
