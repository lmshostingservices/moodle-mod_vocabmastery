{{!
    @template mod_vocabmastery/activation

    Administrator activation page. Never receives the API key.

    Example context (json):
    {
        "actionurl": "https://example.com/mod/vocabmastery/activation.php", "sesskey": "abc",
        "sourcecentral": true, "sourcelocal": false, "sourcenone": false, "siteid": "LMS-1",
        "centralurl": "https://example.com/admin/settings.php?section=local_aiconfig",
        "localurl": "https://example.com/admin/settings.php?section=modsettingvocabmastery",
        "statelabel": "Locked", "stateclass": "bg-warning text-dark", "checked": "28 September 2026", "unlockedat": "",
        "entitlementsource": "", "balance": "120", "hasbalance": true, "pending": false, "haslive": true,
        "price": 50, "pricefree": false, "releaseshort": "0edd43021321", "livereason": "",
        "cancheck": true, "canunlock": true, "isunlocked": false
    }
}}
<div class="vm-activation">
    <p>{{#str}}act_intro, mod_vocabmastery{{/str}}</p>
    <div class="alert alert-info">{{#str}}act_licensingnote, mod_vocabmastery{{/str}}</div>

    <h3 class="h5">{{#str}}act_credentials, mod_vocabmastery{{/str}}</h3>
    {{#sourcecentral}}<p>{{#str}}lmslabs_using_central, mod_vocabmastery, {{siteid}}{{/str}}</p>{{/sourcecentral}}
    {{#sourcelocal}}<p>{{#str}}lmslabs_using_local, mod_vocabmastery, {{siteid}}{{/str}}</p>{{/sourcelocal}}
    {{#sourcenone}}<div class="alert alert-warning">{{#str}}lmslabscredentialsmissing, mod_vocabmastery{{/str}}</div>{{/sourcenone}}
    <p>
        {{#centralurl}}<a href="{{centralurl}}">{{#str}}lmslabs_open_central, mod_vocabmastery{{/str}}</a> · {{/centralurl}}
        <a href="{{localurl}}">{{#str}}act_localsettings, mod_vocabmastery{{/str}}</a>
    </p>

    <h3 class="h5">{{#str}}act_status, mod_vocabmastery{{/str}}</h3>
    <table class="table table-sm vm-activation-table">
        <tbody>
            <tr><th scope="row">{{#str}}act_access, mod_vocabmastery{{/str}}</th>
                <td><span class="badge {{stateclass}}">{{statelabel}}</span>{{#checked}} <span class="text-muted small">{{#str}}act_lastchecked, mod_vocabmastery, {{checked}}{{/str}}</span>{{/checked}}</td></tr>
            <tr><th scope="row">{{#str}}act_balance, mod_vocabmastery{{/str}}</th>
                <td>{{#hasbalance}}{{balance}}{{/hasbalance}}{{^hasbalance}}<span class="text-muted">{{#str}}act_balanceunknown, mod_vocabmastery{{/str}}</span>{{/hasbalance}}</td></tr>
            <tr><th scope="row">{{#str}}act_price, mod_vocabmastery{{/str}}</th>
                <td>{{#haslive}}{{#pricefree}}{{#str}}act_pricefree, mod_vocabmastery{{/str}}{{/pricefree}}{{^pricefree}}{{#str}}act_pricecredits, mod_vocabmastery, {{price}}{{/str}}{{/pricefree}} <span class="text-muted small">{{#str}}act_release, mod_vocabmastery, {{releaseshort}}{{/str}}</span>{{/haslive}}{{^haslive}}<span class="text-muted">{{livereason}}</span>{{/haslive}}</td></tr>
            {{#unlockedat}}<tr><th scope="row">{{#str}}act_unlockedat, mod_vocabmastery{{/str}}</th><td>{{unlockedat}}</td></tr>{{/unlockedat}}
            {{#entitlementsource}}<tr><th scope="row">{{#str}}act_entitlementsource, mod_vocabmastery{{/str}}</th><td>{{entitlementsource}}</td></tr>{{/entitlementsource}}
        </tbody>
    </table>
    {{#pending}}<div class="alert alert-warning">{{#str}}act_pendingnotice, mod_vocabmastery{{/str}}</div>{{/pending}}

    <div class="vm-activation-actions">
        {{#cancheck}}
        <form method="post" action="{{actionurl}}" class="d-inline">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="check">
            <button type="submit" class="btn btn-secondary">{{#str}}act_check, mod_vocabmastery{{/str}}</button>
        </form>
        {{/cancheck}}
        {{#canunlock}}
        <form method="post" action="{{actionurl}}" class="d-inline">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="review">
            <button type="submit" class="btn btn-primary">{{#str}}act_unlock, mod_vocabmastery{{/str}}</button>
        </form>
        {{/canunlock}}
    </div>
    {{#isunlocked}}<p class="text-success mt-3">{{#str}}act_unlockeddone, mod_vocabmastery{{/str}}</p>{{/isunlocked}}
</div>
