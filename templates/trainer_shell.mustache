{{!
    @template mod_vocabmastery/trainer_shell

    Frame of a training session. Regions are filled by mod_vocabmastery/trainer.

    Example context (json):
    {
        "mode": "practice", "modetitle": "Practice", "exitlabel": "Exit",
        "icons": {"close": {"ic_close": true} }
    }
}}
<div class="vm-trainer vm-trainer-{{mode}}">
    <div class="vm-tr-top">
        <span class="vm-tr-mode">{{modetitle}}</span>
        <span class="vm-tr-count" data-region="count"></span>
        <span class="vm-tr-clock" data-region="clock" aria-hidden="true"></span>
        <button type="button" class="vm-tr-exit" data-action="exit" aria-label="{{exitlabel}}" title="{{exitlabel}}">{{#icons.close}}{{> mod_vocabmastery/icon}}{{/icons.close}}</button>
    </div>
    <div class="vm-bar vm-bar-thin" aria-hidden="true"><div class="vm-bar-fill" data-region="bar"></div></div>
    <div class="vm-tr-card" data-region="card"></div>
    <div class="vm-tr-stats" data-region="stats"></div>
</div>
