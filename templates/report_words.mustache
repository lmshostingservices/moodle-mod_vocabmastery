{{!
    @template mod_vocabmastery/report_words

    Class-wide most difficult vocabulary.

    Example context (json):
    {
        "haswords": true,
        "words": [{"display": "die Anmeldung", "translation": "registration", "correct": "die", "topic": "B1 · Lektion 1",
            "wrongrate": 41, "wrong": "9 / 22", "struggling": "3 / 8"}]
    }
}}
<p class="text-muted">{{#str}}difficultwords_help, mod_vocabmastery{{/str}}</p>
{{^haswords}}<div class="alert alert-info">{{#str}}nodifficultitems, mod_vocabmastery{{/str}}</div>{{/haswords}}
{{#haswords}}
<div class="table-responsive">
<table class="table table-sm table-striped">
    <thead><tr>
        <th scope="col">{{#str}}field_prompt, mod_vocabmastery{{/str}}</th>
        <th scope="col">{{#str}}field_correctvalue, mod_vocabmastery{{/str}}</th>
        <th scope="col">{{#str}}topic, mod_vocabmastery{{/str}}</th>
        <th scope="col">{{#str}}wrongrate, mod_vocabmastery{{/str}}</th>
        <th scope="col">{{#str}}answers, mod_vocabmastery{{/str}}</th>
        <th scope="col">{{#str}}studentsstruggling, mod_vocabmastery{{/str}}</th>
    </tr></thead>
    <tbody>
        {{#words}}
        <tr>
            <td>{{display}}{{#translation}}<div class="small text-muted">{{translation}}</div>{{/translation}}</td>
            <td>{{correct}}</td>
            <td>{{topic}}</td>
            <td><b>{{wrongrate}}%</b></td>
            <td>{{wrong}}</td>
            <td>{{struggling}}</td>
        </tr>
        {{/words}}
    </tbody>
</table>
</div>
{{/haswords}}
