{{!
    @template mod_vocabmastery/trainer_flashcard

    Learn-mode card.

    Example context (json):
    {
        "setname": "Nomen + Artikel", "prompt": "Vater", "translation": "father", "full": "der Vater", "plural": "Väter",
        "reveallabel": "Show answer", "knowlabel": "I know this", "morelabel": "Need more practice"
    }
}}
<div class="vm-tr-instruction">{{setname}}</div>
<div class="vm-tr-prompt">{{prompt}}</div>
{{#translation}}<div class="vm-tr-translation">{{translation}}</div>{{/translation}}
<div class="vm-flash-back" data-region="back" hidden>
    <div class="vm-flash-answer">{{full}}</div>
    {{#plural}}<div class="vm-muted">({{plural}})</div>{{/plural}}
    {{#hint}}<div class="vm-tr-hint">{{hint}}</div>{{/hint}}
    {{#explanation}}<div class="vm-muted vm-small">{{explanation}}</div>{{/explanation}}
</div>
<div class="vm-tr-actions">
    <button type="button" class="vm-btn vm-btn-primary" data-action="reveal">{{reveallabel}}</button>
    <button type="button" class="vm-btn vm-btn-good" data-action="know" hidden>{{knowlabel}}</button>
    <button type="button" class="vm-btn vm-btn-warn" data-action="more" hidden>{{morelabel}}</button>
</div>
