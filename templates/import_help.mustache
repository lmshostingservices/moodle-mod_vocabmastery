{{!
    @template mod_vocabmastery/import_help

    Instructions, downloads and the copyable ChatGPT prompt for the table import.

    Example context (json):
    {
        "xlsxurl": "https://example.com/mod/vocabmastery/sample.php?id=1&type=xlsx",
        "csvurl": "https://example.com/mod/vocabmastery/sample.php?id=1&type=csv",
        "prompturl": "https://example.com/mod/vocabmastery/sample.php?id=1&type=prompt",
        "prompt": "You are preparing vocabulary...",
        "uniqid": "vm1",
        "columns": [{"name": "answer", "required": true, "desc": "The value students must choose or type."}]
    }
}}
<div class="vm-importhelp card mb-4">
    <div class="card-body">
        <h3 class="h5">{{#str}}importhelp_title, mod_vocabmastery{{/str}}</h3>
        <ol class="vm-importhelp-steps">
            <li>{{#str}}importhelp_step1, mod_vocabmastery{{/str}}</li>
            <li>{{#str}}importhelp_step2, mod_vocabmastery{{/str}}</li>
            <li>{{#str}}importhelp_step3, mod_vocabmastery{{/str}}</li>
            <li>{{#str}}importhelp_step4, mod_vocabmastery{{/str}}</li>
            <li>{{#str}}importhelp_step5, mod_vocabmastery{{/str}}</li>
        </ol>
        <div class="vm-importhelp-downloads mb-3">
            <a class="btn btn-primary" href="{{xlsxurl}}">{{#str}}downloadsamplexlsx, mod_vocabmastery{{/str}}</a>
            <a class="btn btn-outline-secondary" href="{{csvurl}}">{{#str}}downloadsamplecsv, mod_vocabmastery{{/str}}</a>
            <a class="btn btn-outline-secondary" href="{{prompturl}}">{{#str}}downloadprompt, mod_vocabmastery{{/str}}</a>
        </div>

        <details class="vm-importhelp-columns mb-3">
            <summary>{{#str}}importhelp_columns, mod_vocabmastery{{/str}}</summary>
            <table class="table table-sm mt-2">
                <thead>
                    <tr>
                        <th scope="col">{{#str}}column, mod_vocabmastery{{/str}}</th>
                        <th scope="col">{{#str}}description{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#columns}}
                    <tr>
                        <td><code>{{name}}</code>{{#required}} <span class="badge bg-primary">{{#str}}required{{/str}}</span>{{/required}}</td>
                        <td>{{desc}}</td>
                    </tr>
                    {{/columns}}
                </tbody>
            </table>
            <p class="small text-muted mb-0">{{#str}}importhelp_columnsnote, mod_vocabmastery{{/str}}</p>
        </details>

        <h4 class="h6">{{#str}}chatgptheading, mod_vocabmastery{{/str}}</h4>
        <p class="small">{{#str}}chatgptintro, mod_vocabmastery{{/str}}</p>
        <label for="{{uniqid}}-prompt" class="visually-hidden sr-only">{{#str}}chatgptheading, mod_vocabmastery{{/str}}</label>
        <textarea id="{{uniqid}}-prompt" class="form-control vm-importhelp-prompt" rows="12" readonly>{{prompt}}</textarea>
        <div class="mt-2">
            <button type="button" class="btn btn-secondary" data-action="copytoclipboard"
                data-clipboard-target="#{{uniqid}}-prompt"
                data-clipboard-success-message="{{#str}}promptcopied, mod_vocabmastery{{/str}}">
                {{#str}}copyprompt, mod_vocabmastery{{/str}}
            </button>
        </div>
        <p class="small text-muted mt-2 mb-0">{{#str}}chatgptprivacy, mod_vocabmastery{{/str}}</p>
    </div>
</div>
{{#js}}
require(['core/copy_to_clipboard']);
{{/js}}
